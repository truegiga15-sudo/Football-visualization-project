{
  "name": "football-visualization-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "description": "Production-grade football analytics platform foundation for StatsBomb Event and 360 data visualizations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
